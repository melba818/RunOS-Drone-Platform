# Copy to .env and change the password before exposing this deployment.
# cp .env.example .env

# Auth mode: local (standalone admin login) or nexushive (RunHive portal tickets).
RUNOS_AUTH_MODE=local

# Standalone admin account (local mode only). Change the password!
RUNOS_ADMIN_USER=admin
RUNOS_ADMIN_PASSWORD=runos-demo

# Port published on the host loopback for the web UI.
RUNOS_PORT=19000
